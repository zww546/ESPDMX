# ===== Android (StageDMX) =====
.gradle/
.idea/
.kotlin/
build/
*.apk
local.properties
app/build/
*.iml

# ===== ESP-IDF (stagedmx_std) =====
stagedmx_std/build/
stagedmx_std/managed_components/
# sdkconfig 是 idf.py 生成的派生文件：入库会永久屏蔽 sdkconfig.defaults
# （改 defaults 不生效）。只保留 sdkconfig.defaults。
stagedmx_std/sdkconfig
# 同理：stagedmx_sniff/sdkconfig 也是 idf.py 生成的派生文件。
# 它以前被误入库 —— 结果是每次 idf.py build 都会改它、脏掉工作区。
# ⚠ .gitignore 对「已跟踪」的文件无效：还需要执行一次
#      git rm --cached stagedmx_sniff/sdkconfig
#   把它从索引里摘掉，之后才会真正被忽略。
stagedmx_sniff/sdkconfig
stagedmx_sniff/build/
*.elf
*.map
# Python 工具链缓存
__pycache__/
*.pyc

# ===== 备份文件 =====
*.bak

# ===== 灯库测试数据（手工放在根目录的 zip，不是工程源码）=====
*.zip
# 例外：单元测试用的真实样本必须入库，否则干净 clone / CI 上测试跑不起来。
# 注意：git 的否定规则不能救"已经被忽略的父目录"，所以上面不能写目录级规则。
!StageDMX/app/src/test/resources/*.zip

# ===== 发布产物（APK / 固件 bin，不入库，用 Release 分发）=====
release_assets/
app/release/

# ===== 本地 UI 设计运行产物（截图 / 生成页面 / 设计工具导出）=====
StageDMX/ui-design-runs/
StageDMX/layout_backups/
StageDMX/style.json

# ===== 系统 =====
.DS_Store
Thumbs.db