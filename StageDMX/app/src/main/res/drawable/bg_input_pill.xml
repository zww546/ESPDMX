<?xml version="1.0" encoding="utf-8"?>
<!--
  输入框专用胶囊背景。

  为什么要单独做一个：原来"起始地址"用的是 bg_pill（半径 10dp、无描边），
  而同一行的按钮是 Material3 的胶囊形（半径 = 高度/2，带描边）——
  两者圆角不同、视觉高度也不同（EditText 36dp vs 按钮 38/42dp），
  摆在一起明显"不齐"。这里统一成：半径 19dp（= 38dp 高度的一半）、1dp 描边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface2" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/textDim" />
</shape>
