<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 灯具名标签（选中实例/灯库时显示） -->
    <TextView
        android:id="@+id/tvFixtureLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- 总控最大亮度：作用于全部实例（所有 DMX 输出按该百分比缩放） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/s_master"
            android:textColor="@color/textDim"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekMaster"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:max="100"
            android:progress="100"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:splitTrack="false"
            android:progressDrawable="@drawable/fader_progress"
            android:thumb="@drawable/fader_thumb" />

        <TextView
            android:id="@+id/tvMaster"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="100%"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="15sp" />
    </LinearLayout>

    <!--
      状态总览条（v9）：一行看完"连没连、DMX 出没出、在跑什么"。
      数据来自固件 0x82 状态帧（v9 起尾部带 DMX 遥测）。
      设计上**不占用可点区域**：纯展示，避免和推子抢操作。
    -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvStLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/textDim" />

        <TextView
            android:id="@+id/tvStDmx"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="11sp"
            android:textColor="@color/textDim" />

        <TextView
            android:id="@+id/tvStRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/textDim" />
    </LinearLayout>

    <!-- 快捷操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBlackout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            android:text="@string/s_blackout" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:text="@string/s_locate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlash"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:text="Flash" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecord"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            android:layout_marginStart="4dp"
            android:text="@string/s_record" />
    </LinearLayout>

    <!-- 推子区 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChannels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp" />

</LinearLayout>
