<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/bg">

    <!-- 页签：内置效果 / 程序（与"灯具"页的 App灯库/设备灯库/文件管理 同一套交互） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/btnTabBuiltin"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="内置效果"
            android:textSize="13sp"
            android:textColor="@color/text"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_pill_outline_white"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btnTabProgram"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="程序"
            android:textSize="13sp"
            android:textColor="@color/text"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_pill_outline_white" />
    </LinearLayout>

    <!-- ================= 内置效果 ================= -->
    <LinearLayout
        android:id="@+id/layoutFxBuiltin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

    <!-- 当前效果 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <HorizontalScrollView
            android:id="@+id/runFxScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingBottom="4dp">
            <LinearLayout
                android:id="@+id/runFxCards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvFxStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="未启动"
            android:textColor="@color/textDim"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFxPresets"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:textSize="12sp"
            android:text="@string/s_presets" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFxStop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="停止"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFxPresets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/fxParams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:visibility="gone">

        <!-- 作用范围（v6 阵列） -->
        <TextView
            android:id="@+id/tvFxArray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="作用范围：单台"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/tvAmplitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="幅度: 128"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekAmplitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="128" />

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="速度: 128"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:paddingTop="2dp" />

        <SeekBar
            android:id="@+id/seekSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="128" />

        <!-- v6：相位扩散（波浪的唯一来源） -->
        <TextView
            android:id="@+id/tvSpread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扩散: 0°"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:paddingTop="2dp" />

        <SeekBar
            android:id="@+id/seekSpread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="0" />

        <!-- v6：整体相位 -->
        <TextView
            android:id="@+id/tvPhase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="相位: 0°"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:paddingTop="2dp" />

        <SeekBar
            android:id="@+id/seekPhase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:progress="0" />

        <!-- v6：波形 / 方向 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="波形"
                android:textColor="@color/textDim"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spShape"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="方向"
                android:textColor="@color/textDim"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spDirection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- v6：阵列包络 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="包络"
                android:textColor="@color/textDim"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spEnvelope"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout><!-- /layoutFxBuiltin -->

    <!-- ================= 程序（内容由代码把 page_program 的根视图装进来） ================= -->
    <LinearLayout
        android:id="@+id/layoutProgram"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone" />
</LinearLayout>