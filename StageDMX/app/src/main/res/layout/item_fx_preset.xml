<?xml version="1.0" encoding="utf-8"?>
<!--
  内置效果列表项（v9.2：单列列表，每行一个效果）。

  ## 为什么改回单列
  3 列网格在效果只有十几个时"看着挺整齐"，但每格太窄：名称要么被截断、要么靠
  压小字号硬塞；而且一排开关看过去全是圆钮，找不到重点。
  单列整行宽度充裕 —— 名称完整、参数能说明白、开关是列表里最好认的控件。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="3dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvFxName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvFxParams"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/textDim"
        android:textSize="11sp"
        android:layout_marginEnd="10dp" />

    <!-- 每个效果条目的独立启停开关：打开=启动该效果，关闭=停止该效果 -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swFxItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="22dp"
        android:minWidth="36dp"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:checked="false"
        android:contentDescription="@string/s_fx_item_switch" />
</LinearLayout>