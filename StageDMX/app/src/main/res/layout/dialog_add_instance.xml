<?xml version="1.0" encoding="utf-8"?>
<!-- 添加灯具实例：先选「A/B 通道」，再填「起始地址 / 数量」即可批量铺开。
     第 k 台的地址 = 起始地址 + (k-1)×灯型通道数，全部落在所选通道的 1-512 内。
     用 ScrollView 包住：软键盘弹出时（约 1240px 高）内容可滚动，
     否则底部的输入框会被键盘永久遮住。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/s_fixture_type"
        android:textColor="@color/textDim"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spInstType"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvInstChCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="@color/accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvBandLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/s_band_a_b_a_universe_1_b_universe_2"
        android:textColor="@color/textDim"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/btnBandA"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="@string/s_band_a"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_pill_outline_white"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btnBandB"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="@string/s_band_b"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_pill_outline_white" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/s_start_address_1_512"
        android:textColor="@color/textDim"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etInstAddr"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:hint="1"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="3"
        android:text="1"
        android:textColor="@color/text"
        android:textColorHint="@color/textDim"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/s_count"
        android:textColor="@color/textDim"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etInstCount"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:hint="1"
        android:importantForAutofill="no"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:maxLength="2"
        android:text="1"
        android:textColor="@color/text"
        android:textColorHint="@color/textDim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvInstPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@color/textDim"
        android:textSize="12sp" />

</LinearLayout>
</ScrollView>

