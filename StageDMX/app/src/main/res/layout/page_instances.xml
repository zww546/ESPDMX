<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="8dp">

    <!-- 标题（底部导航直达，不再需要返回按钮） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="实例管理"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- 实例列表标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvInstListTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="参与同时控制的实例（勾选，按地址顺序）"
            android:textColor="@color/textDim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvInstCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/textDim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 批量操作栏（长按任意一行进入多选后显示） -->
    <LinearLayout
        android:id="@+id/instBatchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstSelectAll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:text="全选"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstSelectNone"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:text="取消全选"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvInstSelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="已选 0"
            android:textColor="@color/warn"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstDeleteSel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="删除选中"
            android:textSize="13sp"
            android:textColor="@color/err" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstExitEdit"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:text="完成"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 编辑模式提示 -->
    <TextView
        android:id="@+id/tvInstEditHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="已进入多选：点行勾选，可「全选」后删除"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInstanceMgr"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvInstMgrHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="勾选后回到推子页，滑条 / 定位 / 全黑 / Flash 会同时作用于所有勾选的灯。"
        android:textColor="@color/textDim"
        android:textSize="11sp"
        android:paddingTop="6dp" />
</LinearLayout>
