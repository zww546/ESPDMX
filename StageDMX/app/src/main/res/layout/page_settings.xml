<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== 语言 / Language ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="语言 / Language"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="推子页通道名的显示语言（全局设置，不再逐个灯库单独切换）"
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnLangZh"
                    android:layout_width="52dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="中文"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_outline_accent"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnLangEn"
                    android:layout_width="52dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="EN"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_outline_white"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ===== 推子页排列方式 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="推子页排列方式（当前灯型）"
                android:textColor="@color/textDim"
                android:textSize="12sp"
                android:paddingBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvLayoutMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="按通道顺序"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayoutChannel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:textSize="12sp"
                    android:text="按通道顺序" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayoutCustom"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:textSize="12sp"
                    android:text="自定义顺序" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="10dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="排列预设"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spLayoutPreset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayoutEdit"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:textSize="12sp"
                    android:text="编辑顺序" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayoutSave"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:textSize="12sp"
                    android:text="保存为预设" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLayoutDelete"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:minWidth="0dp"
                    android:textSize="12sp"
                    android:text="删除预设" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLayoutHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="先应用一个灯库/实例，再在这里调整推子页通道的排列顺序。"
                android:textColor="@color/textDim"
                android:textSize="11sp"
                android:paddingTop="8dp" />

            <!-- ===== 灯库编辑（从“灯具”页移入） ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="灯库编辑"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="新建 / 修改灯型的通道与属性，并导出 ZIP"
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOpenEditor"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="14dp"
                    android:gravity="center"
                    android:text="打开"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
