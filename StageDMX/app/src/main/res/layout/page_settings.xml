<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（v9）：按用途分组。

  分组的意义：原来 5 项平铺，加一项就更难找。现在分成
  显示 / 输出 / 工具 三组，新增项有地方放，用户也能按"我要改什么"去找。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/s_settings"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== 显示 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s_group_display"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/s_language"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/s_display_language_for_the_whole_app_chann"
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnLangZh"
                    android:layout_width="52dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:text="@string/s_s"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_outline_accent"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnLangEn"
                    android:layout_width="52dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="EN"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_outline_white"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 推子页按功能分组折叠 -->
            <LinearLayout
                android:id="@+id/rowFaderGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/s_fader_grouping"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvFaderGroupHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/s_fader_group_hint"
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swFaderGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    app:thumbTint="@color/ok"
                    app:trackTint="@color/surface2" />
            </LinearLayout>

            <!-- ==================== 输出 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s_group_output"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/rowDualUniverse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/s_dual_universe"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvDualUniverseHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/s_on_a_b_dmx_1024_channels"
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swDualUniverse"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    app:thumbTint="@color/ok"
                    app:trackTint="@color/surface2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowRdm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RDM"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvRdmHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/s_enables_rdm_scan_and_management_on_the_f"
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swRdm"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    app:thumbTint="@color/ok"
                    app:trackTint="@color/surface2" />
            </LinearLayout>

            <!-- RDM 建实例时地址冲突怎么办（v9.3） -->
            <LinearLayout
                android:id="@+id/rowRdmOverwrite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="6dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/s_rdm_overwrite"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvRdmOverwriteHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swRdmOverwrite"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    app:thumbTint="@color/ok"
                    app:trackTint="@color/surface2" />
            </LinearLayout>

            <!-- ==================== 工具 ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/s_group_tools"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/s_fixture_editor_2"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/s_create_or_edit_fixture_types_export_as_z"
                        android:textColor="@color/textDim"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnOpenEditor"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="14dp"
                    android:gravity="center"
                    android:text="@string/s_open"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
